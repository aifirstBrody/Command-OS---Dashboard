# Peak Refuel — Command OS Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# ── Acumatica ──────────────────────────────────────────────────────────────
ACUMATICA_BASE_URL=https://yourinstance.acumatica.com/entity/Default/23.200.001
ACUMATICA_USERNAME=apiuser
ACUMATICA_PASSWORD=changeme
# Set to "production" to enable write-back. Default is sandbox (read-only).
ACUMATICA_MODE=sandbox

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX
SLACK_BOT_TOKEN=xoxb-...

# ── Twilio (SMS) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+18005551234

# ── AI / LLM (backend only — never exposed to browser) ────────────────────
OPENAI_API_KEY=sk-...
# OR
ANTHROPIC_API_KEY=sk-ant-...
# Model used by /api/chat
CHAT_MODEL=gpt-4o

# ── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
GOOGLE_SHEETS_OPS_LOG_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Obsidian Bridge ────────────────────────────────────────────────────────
# Path to your local Obsidian vault (accessed via the backend bridge)
OBSIDIAN_VAULT_PATH=/Users/you/Documents/PeakRefuel-Vault
# Optional: Obsidian Local REST API plugin URL (if using that plugin)
OBSIDIAN_API_URL=http://localhost:27123
OBSIDIAN_API_KEY=your_obsidian_plugin_key

# ── Backend ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Session secret for any auth layer you add
SESSION_SECRET=change_this_to_a_long_random_string

# ── Agent flags (all disabled by default) ─────────────────────────────────
ROCKY_AGENT_ENABLED=false
SIMON_ARCHIVE_ENABLED=false
ACUMATICA_WRITEBACK_ENABLED=false
