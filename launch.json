{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "peak-refuel-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js"],
      "port": 3000,
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "peak-refuel-dev (--watch)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "server/index.js"],
      "port": 3000,
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
