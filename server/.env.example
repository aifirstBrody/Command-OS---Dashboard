# Peak Refuel Command OS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=3000
NODE_ENV=development

# ─── Hermes (OpenAI-compatible endpoint) ──────────────────────────────────────
# The base URL for the Hermes API (must be OpenAI-compatible, e.g. /v1)
HERMES_BASE_URL=http://your-hermes-server/v1
HERMES_API_KEY=your-hermes-api-key
HERMES_MODEL=gpt-4

# ─── Slack ─────────────────────────────────────────────────────────────────────
# Incoming webhook URL for Brody's notification channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/REAL

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Long random string — Brody types /admin TOKEN in the chat widget to unlock admin mode
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-this-to-a-long-random-string

# ─── Acumatica (backend use only — never expose to frontend) ──────────────────
ACU_ENDPOINT=https://yourinstance.acumatica.com/entity/Default/23.200.001
ACU_USER=
ACU_PASS=
